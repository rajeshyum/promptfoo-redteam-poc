# Copy to .env and fill in. NEVER commit .env.
# Used by SupportBot (the app under test) AND by Promptfoo (attack generation + grading default to OpenAI).
OPENAI_API_KEY=sk-...

# Model the SupportBot uses for its chat/function-calling loop. Cheap + supports tool calls.
OPENAI_MODEL=gpt-4o-mini

# Remediation demo toggle (design §7.1 beat 6). 0 = vulnerable (default), 1 = apply the #9
# markdown-exfil output-sanitization fix. redteam/remediation-demo.sh flips this automatically.
SUPPORTBOT_SANITIZE_OUTPUT=0

# --- Test-harness knobs (all optional; unset = the planted attack surface, unchanged) -------
# Ingest externally-generated documents into the RAG store, so `promptfoo redteam poison`
# output can be planted. Set by hand when running redteam/poison-kb.sh's step 2.
# SUPPORTBOT_EXTRA_DOCS=redteam/output/poisoned-documents
#
# Override the system prompt (eval/regression-demo.sh sets the _FILE form to degrade it, and
# it is also how you test whether a guardrailed prompt closes weakness #1).
# SUPPORTBOT_SYSTEM_PROMPT_FILE=eval/prompts/degraded.txt
# SUPPORTBOT_SYSTEM_PROMPT="..."
#
# Cap the in-process session store (one session per test, so a long scan grows it).
# SUPPORTBOT_MAX_SESSIONS=500
#
# Bound worst-case /chat latency so a stuck OpenAI call can't hang a scan.
# OPENAI_TIMEOUT_S=25
# OPENAI_MAX_RETRIES=0
#
# Point the wrapper scripts at a SupportBot on a different host/port.
# SUPPORTBOT_URL=http://localhost:8000

# Privacy: keep result sharing OFF (see design doc §5).
PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=false

# Promptfoo Cloud API key (app.promptfoo.app -> Settings -> API Keys).
# REQUIRED for remote attack generation: the high-value app-layer plugins
# (bola, bfla, rbac, rag-document-exfiltration, rag-poisoning, ...) refuse to
# generate without it, and it clears the interactive "Email Verification Required"
# gate. Run once:  ./node_modules/.bin/promptfoo auth login --api-key "$PROMPTFOO_API_KEY"
PROMPTFOO_API_KEY=
